<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ITB.CQRS</RootNamespace>
    <PackageId>ITB.CQRS</PackageId>
    <Description>CQRS handlers, dispatcher and decorators (validation, permissions, transactions, error handling) on Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>cqrs;mediator;handlers;fluentvalidation;mapster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="Mapster.EFCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITB.Repository.Abstraction\ITB.Repository.Abstraction.csproj" />
    <ProjectReference Include="..\ITB.Shared.Result\ITB.Shared.Result.csproj" />
    <ProjectReference Include="..\ITB.Shared.Domain\ITB.Shared.Domain.csproj" />
    <ProjectReference Include="..\ITB.Specification\ITB.Specification.csproj" />
  </ItemGroup>

</Project>
